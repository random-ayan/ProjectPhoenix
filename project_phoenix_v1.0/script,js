// তোমার কাঙ্ক্ষিত লক্ষ্য বা মেইনটেন্যান্স শেষ হওয়ার সঠিক তারিখ ও সময় এখানে সেট করো
// ফরম্যাট: "Month Day, Year HH:MM:SS" (যেমন: December 31, 2026 23:59:59)
const targetDate = new Date("December 31, 2026 23:59:59").getTime();

function updateCountdown() {
    const now = new Date().getTime();
    const timeLeft = targetDate - now;

    if (timeLeft < 0) {
        document.getElementById("days").innerText = "00";
        document.ion = "Time's up!";
        return;
    }

    const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
    const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

    // এইচটিএমএল আইডিতে মানগুলো বসানো
    document.getElementById("days").innerText = String(days).padStart(2, '0');
    // যদি তোমার আওয়ার, মিনিট ও সেকেন্ডের আলাদা id থাকে সেগুলোর কোড এখানে যোগ করতে পারো
}

// প্রতি সেকেন্ডে টাইমার আপডেট হবে
setInterval(updateCountdown, 1000);
updateCountdown();